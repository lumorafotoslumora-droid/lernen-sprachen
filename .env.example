# Verbindung zur PostgreSQL-Datenbank (lokal oder z. B. von Render)
DATABASE_URL=postgresql://lls:lls_dev_pw@localhost:5432/lernen_sprachen

# Geheimer Schlüssel zum Signieren der Login-Sitzungen (JWT).
# Für Produktion: langen, zufälligen Wert setzen, z. B. mit
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port, auf dem der Server lokal läuft
PORT=3000

# "production" aktiviert u. a. sichere (HTTPS-only) Cookies
NODE_ENV=development
